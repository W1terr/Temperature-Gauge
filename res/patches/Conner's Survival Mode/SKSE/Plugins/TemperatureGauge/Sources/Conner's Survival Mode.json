{
	"name": "Conner's Survival Mode",
	"description": "Reads Conner's Survival Mode: Survival Mode's cold with the stage values its scripts use, and its switches that turn the cold off (vampires, its menu).",
	"plugin": "Conner's Survival Mode.esp",
	"replaces": "Survival Mode",
	"priority": 5,
	"enabled": [
		{ "global": "0x826", "plugin": "ccQDRSSE001-SurvivalMode.esl", "_": "Survival_ModeEnabled" },
		{ "global": "0x029065", "below": 1, "_": "CRSurvival_ColdShouldBeOff" }
	],
	"cold": { "global": "0x81B", "plugin": "ccQDRSSE001-SurvivalMode.esl", "_": "Survival_ColdNeedValue" },
	"max": { "global": "0x84B", "plugin": "ccQDRSSE001-SurvivalMode.esl", "_": "Survival_ColdNeedMaxValue" },
	"stages": [
		{ "script": { "quest": "0x896", "plugin": "ccQDRSSE001-SurvivalMode.esl", "script": "Survival_NeedCold", "variable": "::needStage1Value_var" }, "default": 50 },
		{ "script": { "quest": "0x896", "plugin": "ccQDRSSE001-SurvivalMode.esl", "script": "Survival_NeedCold", "variable": "::needStage2Value_var" }, "default": 120 },
		{ "script": { "quest": "0x896", "plugin": "ccQDRSSE001-SurvivalMode.esl", "script": "Survival_NeedCold", "variable": "::needStage3Value_var" }, "default": 300 },
		{ "script": { "quest": "0x896", "plugin": "ccQDRSSE001-SurvivalMode.esl", "script": "Survival_NeedCold", "variable": "::needStage4Value_var" }, "default": 500 },
		{ "script": { "quest": "0x896", "plugin": "ccQDRSSE001-SurvivalMode.esl", "script": "Survival_NeedCold", "variable": "::needStage5Value_var" }, "default": 800 }
	],
	"stageNames": [
		{ "spell": "0x890", "plugin": "ccQDRSSE001-SurvivalMode.esl", "fallback": "Warm" },
		{ "spell": "0x86E", "plugin": "ccQDRSSE001-SurvivalMode.esl", "fallback": "Comfortable" },
		{ "spell": "0x891", "plugin": "ccQDRSSE001-SurvivalMode.esl", "fallback": "Chilly" },
		{ "spell": "0x86D", "plugin": "ccQDRSSE001-SurvivalMode.esl", "fallback": "Very Cold" },
		{ "spell": "0x870", "plugin": "ccQDRSSE001-SurvivalMode.esl", "fallback": "Freezing" },
		{ "spell": "0x871", "plugin": "ccQDRSSE001-SurvivalMode.esl", "fallback": "Numb" }
	],
	"comfortableStages": 2,
	"dangerStage": 4,
	"temperatureLevel": { "global": "0x2EDD", "plugin": "Update.esm", "_": "Survival_TemperatureLevel" },
	"target": {
		"level": { "script": { "quest": "0x896", "plugin": "ccQDRSSE001-SurvivalMode.esl", "script": "Survival_NeedCold", "variable": "::currentColdLevel_var" } },
		"levelStages": [ 1, 4, 7, 10, 13 ]
	},
	"hide": {
		"hudPaths": [
			"_root.HUDMovieBaseInstance.TemperatureMeter_mc",
			"_root.HUDMovieBaseInstance.CompassShoutMeterHolder.Compass.CompassTemperatureHolderInstance"
		]
	}
}
